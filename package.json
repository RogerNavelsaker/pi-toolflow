{
  "name": "pi-toolflow",
  "version": "0.2.0",
  "private": false,
  "description": "Pi-facing extension package for installing toolflow into pi-coding-agent",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/RogerNavelsaker/pi-toolflow.git"
  },
  "homepage": "https://github.com/RogerNavelsaker/pi-toolflow#readme",
  "bugs": {
    "url": "https://github.com/RogerNavelsaker/pi-toolflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "toolflow",
    "mcp"
  ],
  "packageManager": "bun@1.3.10",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/toolflow.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "bun --eval \"JSON.parse(await Bun.file('package.json').text()); console.log('package.json ok')\"",
    "pack": "bun pm pack --destination dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@sinclair/typebox": "^0.34.41"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  }
}
